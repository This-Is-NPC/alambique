#!/usr/bin/env bash
# Run the gate (`mise run check`) by hand on HEAD and post a `local-check`
# commit status with the result. Master does not require this status: the
# `ci` check of GitHub Actions is the one that must be green before a merge.
# This script is for running the same gate on your machine.
#
#   scripts/local-check                    gate HEAD, then post (HEAD must be pushed)
#   scripts/local-check --post-only --state=success [--sha=<sha>]
#   scripts/local-check --dry-run [...]    print the API calls instead of posting
#                                          (the gate still runs)
#
# --post-only posts a status without running the gate, for a commit whose gate
# ran elsewhere.
#
# Env:
#   ALAMBIQUE_LOCAL_CHECK_SHA=<s>  same as --sha=
#   ALAMBIQUE_LOCAL_CHECK_DRY_RUN=1  same as --dry-run
set -euo pipefail

root="${MISE_PROJECT_ROOT:-$(git rev-parse --show-toplevel)}"
cd "$root"

DRY_RUN="${ALAMBIQUE_LOCAL_CHECK_DRY_RUN:-0}"
POST_ONLY=0
STATE=""
SHA="${ALAMBIQUE_LOCAL_CHECK_SHA:-}"
for arg in "$@"; do
  case "$arg" in
    --dry-run) DRY_RUN=1 ;;
    --post-only) POST_ONLY=1 ;;
    --state=*) STATE="${arg#--state=}" ;;
    --sha=*) SHA="${arg#--sha=}" ;;
    -h | --help)
      sed -n '2,17p' "$0"
      exit 0
      ;;
    *)
      printf 'local-check: unknown arg: %s\n' "$arg" >&2
      exit 2
      ;;
  esac
done
SHA="${SHA:-$(git rev-parse HEAD)}"
CONTEXT="local-check"

post_now() {
  local state="$1" desc="$2"
  if ((DRY_RUN)); then
    printf '[dry-run] POST /repos/%s/statuses/%s state=%s context=%s desc=%q\n' \
      "$REPO" "$SHA" "$state" "$CONTEXT" "$desc"
    return 0
  fi
  gh api --silent -X POST "repos/$REPO/statuses/$SHA" \
    -f "state=$state" -f "context=$CONTEXT" -f "description=$desc"
}

if ((DRY_RUN)); then
  REPO="dry-run/repo"
elif ! REPO="$(gh repo view --json nameWithOwner --jq .nameWithOwner 2>/dev/null)"; then
  printf 'local-check: gh is not logged in, or this is not a GitHub checkout\n' >&2
  exit 1
fi

if ((POST_ONLY)); then
  if [[ -z "$STATE" ]]; then
    printf 'local-check: --post-only needs --state=...\n' >&2
    exit 2
  fi
  post_now "$STATE" "mise run check - ${STATE} (post-only)"
  exit 0
fi

# The gate runs on the working tree, so it only vouches for the commit it
# runs on when the two are the same tree.
if [[ "$(git rev-parse HEAD)" != "$SHA" ]] || ! git diff --quiet HEAD --; then
  printf 'local-check: %s is not the clean HEAD, and the gate only vouches for the\n' "${SHA:0:7}" >&2
  printf '             tree it runs on. Check it out with nothing changed.\n' >&2
  exit 1
fi

post_now pending "mise run check - running locally"

start="$(date +%s)"
rc=0
mise run check || rc=$?
elapsed=$(($(date +%s) - start))

if ((rc == 0)); then
  state=success
  desc="mise run check - passed in ${elapsed}s"
else
  state=failure
  desc="mise run check - failed (rc=$rc) after ${elapsed}s"
fi

post_now "$state" "$desc"
exit "$rc"
