#!/usr/bin/env bash
# The full gate behind `mise run check`, scripts/local-check and the `gate` job
# of CI. Runs, in order: scripts/quick-check --force (forced warnings-as-errors
# compile, so a stale _build cannot hide a warning, and format checks), clippy,
# the docs link check and the default suite. Stops at the first failure.
#
# Optional heavy checks, off by default:
#   ALAMBIQUE_CHECK_CLUSTER=1   also run `mise run test:cluster`
#   ALAMBIQUE_CHECK_COVERAGE=1  also run `mise run test:coverage`
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
cd "$root"

step() { printf '\n==> %s\n' "$*"; }

"$root/scripts/quick-check" --force

step "cargo clippy"
cargo clippy --manifest-path native/alambique_nif/Cargo.toml --all-targets -- -D warnings

step "docs links"
"$root/scripts/link-check"

step "tests"
mise run test

if [[ "${ALAMBIQUE_CHECK_CLUSTER:-0}" == 1 ]]; then
  step "cluster tests"
  mise run test:cluster
fi
if [[ "${ALAMBIQUE_CHECK_COVERAGE:-0}" == 1 ]]; then
  step "coverage"
  mise run test:coverage
fi

printf '\ncheck: passed\n'
