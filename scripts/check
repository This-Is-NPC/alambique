#!/usr/bin/env bash
# The full gate behind `mise run check` and scripts/local-check. Runs, in
# order: scripts/quick-check --force (forced warnings-as-errors compile, so a
# stale _build cannot hide a warning, and format checks), clippy, cargo-deny and
# the Mix audits, Credo, Dialyzer and the cycle check, the docs link check and
# the default suite. Stops at the first failure.
#
#   ALAMBIQUE_CHECK_TESTS=0     skip the default suite: the static checks that
#                               the `gate` job of CI runs (`mise run
#                               check:static`), since CI runs the suite in the
#                               coverage parts
#
# Optional heavy checks, off by default:
#   ALAMBIQUE_CHECK_CLUSTER=1   also run `mise run test:cluster`
#   ALAMBIQUE_CHECK_COVERAGE=1  also run `mise run test:coverage`
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
cd "$root"

step() { printf '\n==> %s\n' "$*"; }

"$root/scripts/quick-check" --force

step "cargo clippy"
# From the crate directory: its .cargo/config.toml sets the SQLite flags.
(cd native/alambique_nif && cargo clippy --all-targets -- -D warnings)
# The fuzz entry points, and the build with the NIFs that panic on purpose
# (`test-panic`): there clippy::panic is allowed, since the panics are the
# feature; every other lint stays denied.
(cd native/alambique_nif && cargo clippy --all-targets --features fuzzing -- -D warnings)
(cd native/alambique_nif && cargo clippy --all-targets --features test-panic -- -D warnings -A clippy::panic)

step "supply chain"
"$root/scripts/check-deny"
"$root/scripts/check-audit"

step "elixir static analysis"
"$root/scripts/check-elixir-static"

step "docs links"
"$root/scripts/link-check"

if [[ "${ALAMBIQUE_CHECK_TESTS:-1}" != 0 ]]; then
  step "tests"
  mise run test
fi

if [[ "${ALAMBIQUE_CHECK_CLUSTER:-0}" == 1 ]]; then
  step "cluster tests"
  mise run test:cluster
fi
if [[ "${ALAMBIQUE_CHECK_COVERAGE:-0}" == 1 ]]; then
  step "coverage"
  mise run test:coverage
fi

printf '\ncheck: passed\n'
