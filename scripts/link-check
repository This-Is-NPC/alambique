#!/usr/bin/env python3
"""Check the relative links and #anchors of the tracked documentation.

Covers README.md, CHANGELOG.md, AGENTS.md and docs/*.md. External links are
not fetched. Prints one line per broken link and exits 1 if there is any.
"""

import os
import re
import subprocess
import sys
import urllib.parse

PATHSPECS = ["README.md", "CHANGELOG.md", "AGENTS.md", "docs/*.md"]


def tracked_files(root):
    out = subprocess.run(
        ["git", "ls-files", "--", *PATHSPECS],
        cwd=root, capture_output=True, text=True, check=True,
    ).stdout
    return out.split()


def github_slug(text):
    # GitHub slugs the rendered heading, so a link inside keeps only its label.
    text = re.sub(r"!?\[([^\]]*)\]\([^)]*\)", r"\1", text)
    text = re.sub(r"[^\w\s\-]", "", text.lower())
    return re.sub(r"\s+", "-", text).strip("-")


def extract_target(raw):
    # A target in angle brackets may hold spaces or parentheses.
    raw = raw.strip()
    if raw.startswith("<") and ">" in raw:
        return raw[1 : raw.find(">")]
    return raw.split()[0]


def body_lines(content):
    """Yield (number, line) outside code fences."""
    fenced = False
    for n, line in enumerate(content.split("\n"), 1):
        if line.startswith("```"):
            fenced = not fenced
        elif not fenced:
            yield n, line


def anchors_of(content):
    seen, anchors = {}, set()
    for _, line in body_lines(content):
        m = re.match(r"^#+\s+(.+)$", line)
        if m:
            slug = github_slug(m.group(1))
            count = seen.get(slug, 0)
            anchors.add(slug if count == 0 else f"{slug}-{count}")
            seen[slug] = count + 1
    return anchors


def parse_links(content):
    defs = {}
    for _, line in body_lines(content):
        for m in re.finditer(r"\[([^\]]+)\]:\s*(\S.*)$", line):
            defs[m.group(1)] = extract_target(m.group(2))

    links = []
    for n, line in body_lines(content):
        code = [m.span() for m in re.finditer(r"`[^`]*`", line)]

        def in_code(pos):
            return any(a <= pos < b for a, b in code)

        for m in re.finditer(r"!?\[[^\]]*\]\(([^)]+)\)", line):
            if not in_code(m.start()):
                links.append((n, extract_target(m.group(1))))
        for m in re.finditer(r"\[([^\]]+)\]\[([^\]]*)\]", line):
            label = m.group(2) or m.group(1)
            if not in_code(m.start()) and label in defs:
                links.append((n, defs[label]))
    return links


def main():
    root = os.path.abspath(sys.argv[1] if len(sys.argv) > 1 else os.getcwd())
    issues = []
    cache = {}

    def anchors(path):
        if path not in cache:
            with open(path, encoding="utf-8") as f:
                cache[path] = anchors_of(f.read())
        return cache[path]

    for rel in tracked_files(root):
        path = os.path.join(root, rel)
        with open(path, encoding="utf-8") as f:
            content = f.read()
        for n, target in parse_links(content):
            if "://" in target or target.startswith("mailto:"):
                continue
            file_part, _, anchor = target.partition("#")
            if file_part:
                dest = os.path.normpath(
                    os.path.join(os.path.dirname(path), urllib.parse.unquote(file_part))
                )
                if not dest.startswith(root) or not os.path.exists(dest):
                    issues.append(f"{rel}:{n}: link target not found: {target}")
                    continue
            else:
                dest = path
            if anchor and os.path.isfile(dest) and dest.endswith(".md"):
                if github_slug(anchor) not in anchors(dest):
                    issues.append(f"{rel}:{n}: anchor not found: {target}")

    if issues:
        print("\n".join(issues))
    return 1 if issues else 0


sys.exit(main())
