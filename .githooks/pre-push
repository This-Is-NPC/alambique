#!/usr/bin/env bash
# Push gate, installed by `mise run hooks:install`. Fast checks only: the
# warnings-as-errors compile and the format checks (scripts/quick-check). The
# full gate runs on GitHub Actions, on the pull request. Tags and deletions
# carry no new tree and pass. Skip with ALAMBIQUE_SKIP_HOOKS=1, or
# `git push --no-verify`.
set -uo pipefail

[[ "${ALAMBIQUE_SKIP_HOOKS:-0}" == 1 ]] && exit 0

root="$(git rev-parse --show-toplevel)" || exit 1
cd "$root" || exit 1

zero="0000000000000000000000000000000000000000"
push=0
while read -r _local_ref local_sha remote_ref _remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  case "$remote_ref" in refs/tags/*) continue ;; esac
  push=1
done
((push)) || exit 0

mise exec -- scripts/quick-check </dev/null
